# studay 환경 변수 예시
# 이 파일을 .env.local로 복사한 뒤 값을 채우세요: cp .env.example .env.local
# .env.local은 Git에 커밋되지 않습니다(.gitignore).

# Supabase 프로젝트 URL
# Supabase 대시보드 > Project Settings > API (또는 Connect 버튼)에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# 브라우저에 공개되어도 되는 키 (publishable key, sb_publishable_... 형식)
# 데이터 보호는 이 키를 숨기는 것이 아니라 DB의 RLS 정책으로 이뤄집니다.
# 예전 프로젝트라 publishable key가 없다면 NEXT_PUBLIC_SUPABASE_ANON_KEY에 anon key를 넣어도 동작합니다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# 이 앱은 service_role / secret key가 필요하지 않습니다.
# 절대로 NEXT_PUBLIC_ 접두사를 붙여 비밀 키를 등록하지 마세요.

# (선택) Google Analytics 4 측정 ID (G-로 시작). 비워 두면 GA 태그를 아예 불러오지 않습니다.
# GA 관리 > 데이터 스트림 > 웹 스트림에서 확인. 공개되는 값이지만 코드에 하드코딩하지 않고 환경 변수로 관리합니다.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# (선택) true로 두면 모든 이벤트에 debug_mode를 붙여 GA DebugView에 표시합니다. 프로덕션에서는 비워 두세요.
# NEXT_PUBLIC_GA_DEBUG=true

# (선택) DB 통합 테스트용 일회용 PostgreSQL. 실제 Supabase DB 주소를 넣지 마세요.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
